# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: Discord Server (Guild) ID for instant slash command sync during testing.
# Leave empty to sync slash commands globally across all servers the bot is in.
DISCORD_GUILD_ID=

# Channel ID where the daily End-of-Day (EOD) summary & pre-expiry reminder is posted at 16:15 America/New_York
EOD_CHANNEL_ID=

# Time of day in America/New_York (HH:MM, 24-hour format) for the End-of-Day summary (default: 16:15)
EOD_REPORT_TIME=16:15

# Database URL (SQLAlchemy 2.0 Async format)
# 1. Local SQLite (default, zero config):
DATABASE_URL=sqlite+aiosqlite:///data/trades.db

# 2. Cloud PostgreSQL (AWS RDS, Azure Database for PostgreSQL, Supabase, Neon):
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

